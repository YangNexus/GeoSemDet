# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments / editors
.venv/
venv/
.idea/
.vscode/
.DS_Store

# Datasets and generated priors (see README for the expected layout)
data/
*.zip

# Model weights: fetch these per the README instead of committing them.
# The 7 MB HGNetv2-B0 backbone init is the one exception -- it ships, because training
# from the documented recipe needs it.
weight/**/*.pth
weight/**/*.pt
weight/**/*.ts
weight/**/*.npz
weight/**/*.onnx
weight/**/*.engine
!weight/hgnetv2/PPHGNetV2_B0_stage1_MG.pth

# Training artefacts
outputs/
runs/
logs/
*.log
